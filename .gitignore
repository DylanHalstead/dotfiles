# Generated package-manager state
.pnpm-store/
.agents/skills/

# Machine-local assistant settings
**/.claude/settings.local.json
home/.agents/.skill-lock.json

# Secrets
home/.zsh_secrets
home/.config/gh/hosts.yml

# TPM-managed tmux plugins (reinstalled via `prefix + I`)
home/.config/tmux/plugins/

# pi harness — credentials, machine state, and package installs.
# Shared configuration is tracked; ignore per-machine state below.
home/.pi/agent/auth.json
home/.pi/agent/trust.json
home/.pi/agent/models-store.json
home/.pi/agent/sessions/
home/.pi/agent/bin/
home/.pi/agent/npm/
home/.pi/agent/sandbox/projects.json
home/.pi/agent/extensions/*/config.json
home/.pi/agent/extensions/*/logs/
home/.pi/web-search.json
home/.pi/agent/web-search.json
home/.pi/config/
# Per-machine profile dirs (symlinks + per-profile auth.json). profiles.sh is tracked.
home/.pi/profiles/
