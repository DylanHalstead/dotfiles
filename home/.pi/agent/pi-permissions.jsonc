// Trusted-development policy for pi-permission-system.
//
// Normal tools and subprocesses run without prompts. Keep this policy small:
// guardrails.ts owns confirmations that must survive YOLO, while the hard
// denies below stop commands that should never run from an agent session.
{
  "defaultPolicy": {
    "tools": "allow",
    "bash": "allow",
    "mcp": "allow",
    "skills": "allow",
    "special": "allow"
  },

  "tools": {
    "*": "allow",
    // Documentation and dependency inspection should not silently modify
    // skills or installed packages. Shell commands keep their own policy.
    "write:/Users/dylan/.agents": "ask",
    "write:/Users/dylan/.agents/*": "ask",
    "edit:/Users/dylan/.agents": "ask",
    "edit:/Users/dylan/.agents/*": "ask",
    "write:/home/dylan/.agents": "ask",
    "write:/home/dylan/.agents/*": "ask",
    "edit:/home/dylan/.agents": "ask",
    "edit:/home/dylan/.agents/*": "ask",
    "write:*/node_modules": "ask",
    "write:*/node_modules/*": "ask",
    "edit:*/node_modules": "ask",
    "edit:*/node_modules/*": "ask",
    "write:*/pkg/mod": "ask",
    "write:*/pkg/mod/*": "ask",
    "edit:*/pkg/mod": "ask",
    "edit:*/pkg/mod/*": "ask",
    "write:/Users/dylan/.gem": "ask",
    "write:/Users/dylan/.gem/*": "ask",
    "edit:/Users/dylan/.gem": "ask",
    "edit:/Users/dylan/.gem/*": "ask",
    "write:/home/dylan/.gem": "ask",
    "write:/home/dylan/.gem/*": "ask",
    "edit:/home/dylan/.gem": "ask",
    "edit:/home/dylan/.gem/*": "ask",
    "write:/Users/dylan/.local/share/gem": "ask",
    "write:/Users/dylan/.local/share/gem/*": "ask",
    "edit:/Users/dylan/.local/share/gem": "ask",
    "edit:/Users/dylan/.local/share/gem/*": "ask",
    "write:/home/dylan/.local/share/gem": "ask",
    "write:/home/dylan/.local/share/gem/*": "ask",
    "edit:/home/dylan/.local/share/gem": "ask",
    "edit:/home/dylan/.local/share/gem/*": "ask"
  },

  "bash": {
    "*": "allow",

    "*sudo *": "deny",
    "*rm -rf /*": "deny",
    "*rm -rf ~*": "deny",
    "*rm -fr /*": "deny",

    // /tmp is disposable workspace space. These later rules override the
    // broad filesystem-root protections above for its contents only.
    "*rm -rf /tmp/*": "allow",
    "*rm -rf /private/tmp/*": "allow",
    "*rm -fr /tmp/*": "allow",
    "*rm -fr /private/tmp/*": "allow",
    "*mkfs*": "deny",
    "*dd if=*of=/dev/*": "deny",
    "*chmod -R 777 /*": "deny",
    "*terraform destroy*": "deny",
    "*curl * | sh*": "deny",
    "*curl * | bash*": "deny",
    "*wget * | sh*": "deny",
    "*wget * | bash*": "deny"
  },

  "mcp": {
    "*": "allow"
  },

  "skills": {
    "*": "allow"
  },

  "special": {
    "doom_loop": "ask",
    "external_directory": "ask",
    // Match the requested path, including symlink aliases such as ~/.agents.
    // Wildcards span directory separators, including nested dependencies.
    "external_directory:/Users/dylan/.agents": "allow",
    "external_directory:/Users/dylan/.agents/*": "allow",
    "external_directory:/home/dylan/.agents": "allow",
    "external_directory:/home/dylan/.agents/*": "allow",
    "external_directory:*/node_modules": "allow",
    "external_directory:*/node_modules/*": "allow",
    "external_directory:*/pkg/mod": "allow",
    "external_directory:*/pkg/mod/*": "allow",
    "external_directory:/Users/dylan/.gem": "allow",
    "external_directory:/Users/dylan/.gem/*": "allow",
    "external_directory:/home/dylan/.gem": "allow",
    "external_directory:/home/dylan/.gem/*": "allow",
    "external_directory:/Users/dylan/.local/share/gem": "allow",
    "external_directory:/Users/dylan/.local/share/gem/*": "allow",
    "external_directory:/home/dylan/.local/share/gem": "allow",
    "external_directory:/home/dylan/.local/share/gem/*": "allow",
    "external_directory:/tmp/*": "allow",
    "external_directory:/private/tmp/*": "allow",
    // A trailing /* does not match the directory itself, which tools may
    // inspect before traversing it.
    "external_directory:/Users/dylan/repos": "allow",
    "external_directory:/Users/dylan/repos/*": "allow",
    "external_directory:/Users/dylan/dotfiles": "allow",
    "external_directory:/Users/dylan/dotfiles/*": "allow",
    "external_directory:/Users/dylan/.pi": "allow",
    "external_directory:/Users/dylan/.pi/*": "allow",

    // mise owns the installed Ruby, Go, and their standard libraries.
    "external_directory:/Users/dylan/.local/share/mise": "allow",
    "external_directory:/Users/dylan/.local/share/mise/*": "allow",
    // pnpm owns global application packages, including the Pi CLI.
    "external_directory:/Users/dylan/Library/pnpm": "allow",
    "external_directory:/Users/dylan/Library/pnpm/*": "allow",
    "external_directory:/home/dylan/repos": "allow",
    "external_directory:/home/dylan/repos/*": "allow",
    "external_directory:/home/dylan/dotfiles": "allow",
    "external_directory:/home/dylan/dotfiles/*": "allow",
    "external_directory:/home/dylan/.pi": "allow",
    "external_directory:/home/dylan/.pi/*": "allow",
    "external_directory:/home/dylan/.local/share/mise": "allow",
    "external_directory:/home/dylan/.local/share/mise/*": "allow",
    "external_directory:/home/dylan/.local/share/pnpm": "allow",
    "external_directory:/home/dylan/.local/share/pnpm/*": "allow",
    "external_directory:/opt/homebrew/Cellar/pi-coding-agent": "allow",
    "external_directory:/opt/homebrew/Cellar/pi-coding-agent/*": "allow",
    "external_directory:/home/linuxbrew/.linuxbrew/Cellar/pi-coding-agent": "allow",
    "external_directory:/home/linuxbrew/.linuxbrew/Cellar/pi-coding-agent/*": "allow"
  }
}
