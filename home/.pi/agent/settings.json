{
  "lastChangelogVersion": "0.84.1",
  "theme": "dracula",
  "defaultThinkingLevel": "low",
  "hideThinkingBlock": true,
  "compaction": {
    "enabled": false
  },
  "terminal": {
    "showImages": true
  },
